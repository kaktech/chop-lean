# Postgres (Neon or Supabase pooled connection string)
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com

# Auth.js + Google (Google Cloud Console OAuth client)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Chop Lean <orders@your-domain>"
MAILGUN_REGION=us
# Optional free fallback if Mailgun isn't set: sends to anyone once BREVO_SENDER_EMAIL is verified in Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Chop Lean"

# Paystack (test mode)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# File uploads (product photos, transfer receipts) - Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Only needed if you use Supabase instead of Neon + Vercel Blob
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp number in international format without "+", e.g. 2348012345678 (used by every "Chat on WhatsApp" link)
NEXT_PUBLIC_WHATSAPP_NUMBER=
